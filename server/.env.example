# Salin ke .env lalu isi nilai sebenarnya. JANGAN commit .env.
PORT=8787

# Secret untuk memverifikasi tanda tangan webhook dari Scalev.
# Ambil/atur dari dashboard webhook Scalev Anda.
SCALEV_WEBHOOK_SECRET=

# Nama header tanda tangan yang dikirim Scalev (cek dokumentasi Scalev).
SCALEV_SIGNATURE_HEADER=x-scalev-signature

# Secret acak untuk menandatangani token verifikasi ke aplikasi.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Lokasi penyimpanan (default ./data/subs.json). Untuk produksi, gunakan database.
# DATA_FILE=./data/subs.json

# Layani aplikasi statis dari folder ini (opsional). Mis. folder root repo.
# STATIC_DIR=../

# Asal yang diizinkan memanggil API (CORS). Untuk produksi, batasi ke domain Anda.
# ALLOW_ORIGIN=https://app.domain-anda.com
