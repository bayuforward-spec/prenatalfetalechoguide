# ====== Server ======
PORT=8787

# ====== YouTube Data API v3 (OAuth2) ======
# Buat di https://console.cloud.google.com  ->  APIs & Services -> Credentials
# Aktifkan dulu "YouTube Data API v3", lalu buat "OAuth client ID" tipe "Web application".
# Tambahkan Authorized redirect URI: http://localhost:8787/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth2callback

# Privasi default video saat diupload: public | unlisted | private
DEFAULT_PRIVACY=unlisted
